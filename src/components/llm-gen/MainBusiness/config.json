{
  "emitEvent": true,
  "fitHeight": true,
  "apis": [
    {
      "method": "post",
      "isFirstScreen": true,
      "alias": "reportOptions",
      "url": "https://data.10jqka.com.cn/basicapi/visual/smart/dev/index/v1/fetch",
      "params": {
        "config_id": "main_business_fetcher_config",
        "business_id": "configurable_fetcher",
        "subjects": ["17-600019"],
        "strategy": "newest",
        "engine": "default",
        "source": "graal_js",
        "extensions": {
          "format": "original"
        }
      },
      "returnValExample": {
        "data": {
          "rows": [
            { "stock_name": "宝钢股份", "year": "2025三季报", "stock_code": "600019" }
          ]
        }
      }
    },
    {
      "method": "post",
      "isFirstScreen": true,
      "alias": "composition",
      "depends": ["reportOptions"],
      "url": "https://data.10jqka.com.cn/basicapi/visual/smart/dev/index/v1/visual",
      "params": {
        "business_id": "configurable_fetcher",
        "config_id": "main_business_structure_test_fetcher_config",
        "subjects": ["17-600019"],
        "strategy": "newest",
        "engine": "default",
        "source": "http_custom",
        "extensions": {
          "analysisTypes": "industry,product,area",
          "specialDate": ""
        }
      },
      "returnValExample": {
        "data": {
          "data": [
            {
              "业务维度": "area",
              "业务名称": "来源于境内的对外交易收入",
              "营业收入": "140275263000.00",
              "营业收入占比": "0.85926079",
              "营业利润": null,
              "营业利润占比": null,
              "毛利率": null,
              "毛利率占比": null
            }
          ]
        }
      }
    }
  ],
  "staticConfig": {
    "chartPanels": [
      { "key": "industry", "title": "按行业分" },
      { "key": "product", "title": "按产品分" },
      { "key": "region", "title": "按地区分" }
    ],
    "tableColumns": [
      {
        "key": "businessName",
        "label": "业务名称",
        "valueType": "text",
        "align": "left"
      },
      {
        "key": "revenue",
        "label": "营业收入（元）",
        "valueType": "amount",
        "align": "right"
      },
      {
        "key": "revenueRatio",
        "label": "收入比例",
        "valueType": "percent",
        "align": "right"
      },
      {
        "key": "cost",
        "label": "营业成本（元）",
        "valueType": "amount",
        "align": "right"
      },
      {
        "key": "costRatio",
        "label": "成本比例",
        "valueType": "percent",
        "align": "right"
      },
      {
        "key": "profit",
        "label": "主营利润（元）",
        "valueType": "amount",
        "align": "right"
      },
      {
        "key": "profitRatio",
        "label": "利润比例",
        "valueType": "percent",
        "align": "right"
      },
      {
        "key": "grossMargin",
        "label": "毛利率",
        "valueType": "percent",
        "align": "right"
      }
    ],
    "businessCategoryMap": {
      "服务贸易及其他": "按行业",
      "金融业务": "按行业",
      "整车业务": "按产品",
      "零部件业务": "按产品",
      "服务贸易（产品）": "按产品",
      "金融业务（产品）": "按产品",
      "中国": "按地区",
      "其他": "按地区",
      "其他地区": "按地区"
    }
  },
  "chartConfig": {
    "pie": {
      "view": {
        "main": {
          "title": [
            {
              "text": "{mainTitle|${centerTitle}}",
              "left": "center",
              "top": "center",
              "textStyle": {
                "fontSize": 12,
                "lineHeight": 18,
                "rich": {
                  "mainTitle": {
                    "fontSize": 12,
                    "lineHeight": 16,
                    "fontWeight": 600
                  }
                }
              }
            }
          ],
          "layers": [
            {
              "type": "pie",
              "radius": ["45%", "72%"],
              "encoding": {
                "x": "name",
                "y": "value",
                "color": "name"
              },
              "label": {
                "formatter": "{b} {d}%",
                "show": false
              },
              "emphasis": {
                "scale": true
              }
            }
          ]
        }
      },
      "token": {
        "dvStandardChart": {
          "baseOption": {
            "legend": {
              "backgroundColor": "transparent"
            },
            "tooltip": {
              "show": false
            }
          }
        }
      }
    },
    "themeColors": {
      "light": {
        "titleColor": "rgba(0,0,0,0.6)",
        "subtitleColor": "#6B7280",
        "legendColor": "#545E71"
      },
      "dark": {
        "titleColor": "#C4CAD5",
        "subtitleColor": "#A9B2BE",
        "legendColor": "#C4CAD5"
      }
    }
  }
}
