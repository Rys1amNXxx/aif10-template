      "profit": { "centerTitle": "利润", "total": 982.43, "scale": 0.52 }
    }
  },
  "chartConfig": {
    "pie": {
      "view": {
        "main": {
          "title": [
            {
              "text": "{mainTitle|${centerTitle}}",
              "left": "center",
              "top": "center",
              "textStyle": {
                "fontSize": 12,
                "lineHeight": 18,
                "rich": {
                  "mainTitle": {
                    "fontSize": 12,
                    "lineHeight": 16,
                    "fontWeight": 600
                  }
                }
              }
            }
          ],
          "layers": [
            {
              "type": "pie",
              "radius": ["45%", "72%"],
              "encoding": {
                "x": "name",
                "y": "value",
                "color": "name"
              },
              "label": {
                "formatter": "{b} {d}%",
                "show": false
              },
              "emphasis": {
                "scale": true
              }
            }
          ]
        }
      },
      "token": {
        "dvStandardChart": {
          "baseOption": {
            "legend": {
              "backgroundColor": "transparent"
            },
            "tooltip": {
              "show": false
            }
          }
        }
      }
    },
    "themeColors": {
      "light": {
        "titleColor": "rgba(0,0,0,0.6)",
        "subtitleColor": "#6B7280",
        "legendColor": "#545E71"
      },
      "dark": {
        "titleColor": "#C4CAD5",
        "subtitleColor": "#A9B2BE",
        "legendColor": "#C4CAD5"
      }
    }
  }
}
