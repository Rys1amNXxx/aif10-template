  "chartConfig": {
    "barLine": {
      "view": {
        "main": {
          "yAxis": [
            {
              "type": "value",
              "name": "金额(万元)",
              "position": "left",
              "boundaryGap": [0, "20%"]
            },
            {
              "type": "value",
              "name": "增长率(%)",
              "position": "right",
              "boundaryGap": [0, "20%"]
            }
          ],
          "layers": [
            {
              "type": "bar",
              "encoding": {
                "x": "date",
                "y": "bar"
              },
              "barMaxWidth": 24,
              "itemStyle": {
                "borderRadius": [4, 4, 0, 0]
              }
            },
            {
              "type": "line",
              "encoding": {
                "x": "date",
                "y": "line"
              },
              "yAxisIndex": 1,
              "smooth": true,
              "symbol": "circle",
              "symbolSize": 6
            }
          ],
          "legend": {
            "show": true,
            "bottom": 0
          },
          "grid": {
            "top": 40,
            "bottom": 40,
            "left": 10,
            "right": 10,
            "containLabel": true
          }
        }
      }
    },
    "treeTable": {
      "view": {
        "main": {
          "layers": [
            {
              "type": "treeTable",
              "encoding": {
                "columns": ["name", "q1", "q2", "q3", "q4", "yoy"],
                "children": "children"
              },
              "columnConfig": {
                "name": { "width": 180, "align": "left", "fixed": "left" },
                "q1": { "width": 100, "align": "right" },
                "q2": { "width": 100, "align": "right" },
                "q3": { "width": 100, "align": "right" },
                "q4": { "width": 100, "align": "right" },
                "yoy": { "width": 100, "align": "right" }
              },
              "headerConfig": {
                "name": "指标名称",
                "q1": "Q1",
                "q2": "Q2",
                "q3": "Q3",
                "q4": "Q4",
                "yoy": "同比"
              }
            }
          ]
        }
      }
    },
    "themeColors": {
      "light": {
        "barColor": "#636FFF",
        "lineColor": "#F2920D",
        "textColor": "#2A354E",
        "borderColor": "#EBEEF6",
        "headerBg": "#F2F5FA"
      },
      "dark": {
        "barColor": "#7B8AFF",
        "lineColor": "#FFB347",
        "textColor": "#C4CAD5",
        "borderColor": "#2C375D",
        "headerBg": "#1D273F"
      }
    }
  }
}
