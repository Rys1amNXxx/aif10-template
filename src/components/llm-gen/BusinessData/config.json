{
  "emitEvent": true,
  "fitHeight": true,
  "apis": [
    {
      "method": "get",
      "isFirstScreen": true,
      "alias": "tabs",
      "url": "https://data.10jqka.com.cn/basicapi/operate/businessdata/v1/tabs",
      "params": {
        "code": "${code}",
        "market": "${market}",
        "locale": "zh_CN",
        "noWithCredentials": 1
      },
      "returnValExample": {
        "tabs": [
          { "id": "revenue", "name": "营业收入" },
          { "id": "profit", "name": "净利润" },
          { "id": "cashflow", "name": "现金流" }
        ]
      }
    },
    {
      "method": "post",
      "isFirstScreen": true,
      "alias": "chartData",
      "depends": ["tabs"],
      "url": "https://data.10jqka.com.cn/basicapi/visual/smart/index/v1/visual",
      "params": {
        "config_id": "business_data_chart_fetcher",
        "subjects": ["${market}-${code}"],
        "engine": "default",
        "strategy": "newest",
        "source": "http_custom",
        "extensions": {
          "tab_id": "${tabs[0].id}"
        }
      },
      "returnValExample": {
        "chart": {
          "data": [
            {
              "values": [
                { "date": "2024-01-01", "bar": 5715620.32, "line": 9490694.01 },
                { "date": "2023-01-01", "bar": 7414532.38, "line": 1463915.85 }
              ]
            }
          ]
        },
        "table": {
          "data": [
            {
              "name": "营业收入",
              "children": [
                {
                  "name": "主营业务收入",
                  "q1": "1234.56",
                  "q2": "2345.67",
                  "q3": "3456.78",
                  "q4": "4567.89",
                  "yoy": "12.34%"
                },
                {
                  "name": "其他业务收入",
                  "q1": "234.56",
                  "q2": "345.67",
                  "q3": "456.78",
                  "q4": "567.89",
                  "yoy": "8.56%"
                }
              ]
            }
          ],
          "columns": [
            { "key": "name", "label": "指标名称", "width": 180 },
            { "key": "q1", "label": "Q1", "align": "right" },
            { "key": "q2", "label": "Q2", "align": "right" },
            { "key": "q3", "label": "Q3", "align": "right" },
            { "key": "q4", "label": "Q4", "align": "right" },
            { "key": "yoy", "label": "同比", "align": "right" }
          ]
        }
      }
    }
  ],
  "mockData": {
    "tabs": [
      { "id": "revenue", "label": "营业收入" },
